# Copy to `.env.local` and fill in. `.env.local` is gitignored; do not commit a
# real form ID's environment file if you would rather not publish it.
#
# These are PUBLIC build-time values. Vite inlines `VITE_*` variables into the
# client bundle, so never put a secret here.

# Formspree form ID — the segment after /f/ in your form's endpoint URL.
#
# Create a form at https://formspree.io, copy its ID, and paste it here.
# With this unset the contact form disables itself and explains that it is not
# connected, instead of showing a success state for a message that was never
# sent. See src/lib/contact/index.ts.
VITE_FORMSPREE_FORM_ID=
